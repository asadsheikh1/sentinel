# SENTINEL ingestion endpoint (ingest.<domain> on AWS, port 4319 locally).
# TLS is added with the AWS deployment (Step 33).
{
	auto_https off
	admin off
}

:4319 {
	request_body {
		max_size 10MB
	}

	@otlp {
		method POST
		path /v1/metrics /v1/logs /v1/traces
	}

	# `route` keeps these directives in the written order.
	route @otlp {
		# Never trust identity headers sent by the client.
		request_header -X-Sentinel-Integration-Id
		request_header -X-Sentinel-Integration-Kind

		forward_auth api:8000 {
			uri /internal/ingest-auth
			header_up X-Sentinel-Internal-Auth {$SENTINEL_INTERNAL_AUTH_SECRET}
			copy_headers X-Sentinel-Integration-Id X-Sentinel-Integration-Kind
		}

		# The token stops here: the Collector and the stores never see it.
		request_header -Authorization
		reverse_proxy gateway:4318
	}

	# SENTINEL Agent: installer files (public) and the per-integration config
	# (ingest token, checked by the API). Read-only, nothing else of the API.
	@agent_files {
		method GET HEAD
		path /agent/install.sh /agent/uninstall.sh /agent/socket-proxy.cfg /agent/Containerfile
	}
	@agent_config {
		method GET
		path_regexp ^/api/v1/integrations/[0-9a-f-]{36}/agent-config$
	}
	route @agent_files {
		request_header -X-Sentinel-Internal-Auth
		reverse_proxy api:8000
	}
	route @agent_config {
		request_header -X-Sentinel-Internal-Auth
		reverse_proxy api:8000
	}

	# The prober's work list (prober token, checked by the API).
	@prober_checks {
		method GET
		path /api/v1/prober/checks
	}
	route @prober_checks {
		request_header -X-Sentinel-Internal-Auth
		reverse_proxy api:8000
	}

	respond 404
}
