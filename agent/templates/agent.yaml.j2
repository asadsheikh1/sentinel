{#-
  SENTINEL Agent: OpenTelemetry Collector (contrib) configuration.

  Rendered by backend/src/sentinel/integrations/agent_config.py. Every value that
  comes from an integration's config is passed through `tojson` (JSON is valid
  YAML), so a log path or a process name can never change the structure of the
  file. The renderer also validates the input and re-parses the output.

  The agent only sends data: the OTLP receiver (for local apps) binds to
  loopback on hosts, and nothing else listens.
-#}
# SENTINEL Agent configuration. Generated by SENTINEL; do not edit by hand.
# Re-run the installer to update it. Config hash: {{ config_hash or "(unhashed)" }}
extensions:
  file_storage:
    directory: {{ storage_dir | tojson }}
    create_directory: false
    timeout: 2s
    compaction:
      on_start: true
      directory: {{ storage_dir | tojson }}

receivers:
  host_metrics:
    collection_interval: {{ interval | tojson }}
{%- if root %}
    root_path: {{ root | tojson }}
{%- endif %}
    scrapers:
      cpu: {}
      load: {}
      memory: {}
      paging: {}
      processes: {}
      disk: {}
      network: {}
      filesystem:
        exclude_fs_types:
          fs_types: [autofs, binfmt_misc, bpf, cgroup, cgroup2, configfs, debugfs, devpts, devtmpfs, fusectl, hugetlbfs, mqueue, nsfs, proc, procfs, pstore, rpc_pipefs, securityfs, selinuxfs, squashfs, sysfs, tracefs, tmpfs]
          match_type: strict
        # Container layers are excluded by path, not by fs type: a host (or a
        # live system) can have its root on overlay.
        exclude_mount_points:
          mount_points: ['^/(dev|proc|sys|run|snap)(/|$)', '^/var/lib/(docker|containers)/', '/\.local/share/containers/']
          match_type: regexp
{%- if watched_processes %}

  # Watched processes only: per-process metrics for every process would be
  # high-cardinality and expensive.
  host_metrics/processes:
    collection_interval: {{ interval | tojson }}
{%- if root %}
    root_path: {{ root | tojson }}
{%- endif %}
    scrapers:
      process:
        include:
          names: {{ watched_processes | tojson }}
          match_type: strict
        mute_process_name_error: true
        mute_process_exe_error: true
        mute_process_io_error: true
        mute_process_user_error: true
        mute_process_cgroup_error: true
{%- endif %}
{%- if journald %}

  journald:
    directory: {{ journal_dir | tojson }}
    start_at: end
    priority: info
    storage: file_storage
{%- if journald_units %}
    units: {{ journald_units | tojson }}
{%- endif %}
{%- endif %}
{%- for f in log_files %}

  file_log/{{ loop.index }}:
    include: [{{ f.path | tojson }}]
    start_at: end
    include_file_path: true
    storage: file_storage
    max_log_size: 64KiB
{%- if f.multiline_start %}
    multiline:
      line_start_pattern: {{ f.multiline_start | tojson }}
{%- endif %}
{%- endfor %}
{%- if containers %}

  # Container stats from the Podman (Docker-compatible) or Docker API, reached only
  # through SENTINEL's GET-only socket proxy, never the raw engine socket.
  docker_stats:
    endpoint: {{ engine_endpoint | tojson }}
    api_version: "1.41"
    collection_interval: {{ interval | tojson }}
    timeout: 10s
    container_labels_to_metric_labels:
      com.docker.compose.service: compose.service
      com.docker.compose.project: compose.project
    metrics:
      container.restarts:
        enabled: true
      container.uptime:
        enabled: true
{%- endif %}

  # The agent's own health: export failures, queue size, dropped data.
  prometheus/self:
    config:
      scrape_configs:
        - job_name: sentinel-agent
          scrape_interval: {{ interval | tojson }}
          static_configs:
            - targets: ["127.0.0.1:{{ self_port }}"]
{%- if scrapes %}

  prometheus/scrape:
    config:
      scrape_configs:
{%- for s in scrapes %}
        - job_name: {{ s.job | tojson }}
          scrape_interval: {{ s.interval | tojson }}
          metrics_path: {{ s.path | tojson }}
          static_configs:
            - targets: [{{ s.target | tojson }}]
{%- endfor %}
{%- endif %}
{%- if otlp %}

  # Local apps send OTLP here; the agent adds host identity and forwards it.
  otlp:
    protocols:
      grpc:
        endpoint: "{{ otlp_host }}:{{ otlp_grpc_port }}"
      http:
        endpoint: "{{ otlp_host }}:{{ otlp_http_port }}"
{%- endif %}

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 200
    spike_limit_mib: 50

  resource_detection:
    detectors: [env, system]
    system:
      hostname_sources: [os]
    override: false

  # Identity of this agent. sentinel.integration.* is set by the SENTINEL gateway
  # from the ingest token; anything the agent sent would be overwritten.
  resource/agent:
    attributes:
      - { key: sentinel.agent.config_hash, value: {{ config_hash | tojson }}, action: upsert }
      - { key: sentinel.agent.version, value: {{ agent_version | tojson }}, action: upsert }
      - { key: deployment.environment.name, value: {{ environment | tojson }}, action: insert }
{%- if journald %}

  # Journal entries arrive as a map; keep the message as the body, map PRIORITY
  # to a severity, and keep a few useful fields as attributes.
  transform/journald:
    error_mode: ignore
    log_statements:
      - context: log
        statements:
          - set(log.attributes["systemd.unit"], log.body["_SYSTEMD_UNIT"]) where IsMap(log.body) and log.body["_SYSTEMD_UNIT"] != nil
          - set(log.attributes["syslog.identifier"], log.body["SYSLOG_IDENTIFIER"]) where IsMap(log.body) and log.body["SYSLOG_IDENTIFIER"] != nil
          - set(log.attributes["container.name"], log.body["CONTAINER_NAME"]) where IsMap(log.body) and log.body["CONTAINER_NAME"] != nil
          - set(log.attributes["container.id"], log.body["CONTAINER_ID_FULL"]) where IsMap(log.body) and log.body["CONTAINER_ID_FULL"] != nil
          - set(log.attributes["journald.priority"], log.body["PRIORITY"]) where IsMap(log.body) and log.body["PRIORITY"] != nil
          - set(log.severity_number, SEVERITY_NUMBER_FATAL) where log.attributes["journald.priority"] != nil and Int(log.attributes["journald.priority"]) <= 2
          - set(log.severity_number, SEVERITY_NUMBER_ERROR) where log.attributes["journald.priority"] == "3"
          - set(log.severity_number, SEVERITY_NUMBER_WARN) where log.attributes["journald.priority"] == "4"
          - set(log.severity_number, SEVERITY_NUMBER_INFO) where log.attributes["journald.priority"] == "5" or log.attributes["journald.priority"] == "6"
          - set(log.severity_number, SEVERITY_NUMBER_DEBUG) where log.attributes["journald.priority"] == "7"
          - set(log.body, log.body["MESSAGE"]) where IsMap(log.body) and log.body["MESSAGE"] != nil
          - delete_key(log.attributes, "journald.priority")

  # Container log lines become their own resource, so they are attributed to the
  # container (and its service), not to the host.
  groupbyattrs/journald:
    keys: [container.name, container.id]
{%- endif %}
{%- if containers %}

  # Compose service and project labels -> service.name / service.namespace.
  transform/containers:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        statements:
          - set(resource.attributes["service.name"], datapoint.attributes["compose.service"]) where datapoint.attributes["compose.service"] != nil
          - set(resource.attributes["service.namespace"], datapoint.attributes["compose.project"]) where datapoint.attributes["compose.project"] != nil
          - delete_key(datapoint.attributes, "compose.service")
          - delete_key(datapoint.attributes, "compose.project")
{%- endif %}

  batch:
    timeout: 5s
    send_batch_size: 2048

exporters:
  otlp_http/sentinel:
    endpoint: ${env:SENTINEL_INGEST_ENDPOINT}
    headers:
      Authorization: "Bearer ${env:SENTINEL_INGEST_TOKEN}"
    compression: gzip
    timeout: 15s
    retry_on_failure:
      enabled: true
      max_elapsed_time: 10m
    sending_queue:
      enabled: true
      storage: file_storage
      queue_size: 2000

service:
  extensions: [file_storage]
  telemetry:
    logs:
      level: warn
    metrics:
      level: normal
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: {{ self_port }}
  pipelines:
    metrics:
      receivers: [{{ metric_receivers | join(", ") }}]
      processors: [{{ metric_processors | join(", ") }}]
      exporters: [otlp_http/sentinel]
{%- if journald %}
    logs/journald:
      receivers: [journald]
      processors: [memory_limiter, transform/journald, groupbyattrs/journald, resource_detection, resource/agent, batch]
      exporters: [otlp_http/sentinel]
{%- endif %}
{%- if log_receivers %}
    logs:
      receivers: [{{ log_receivers | join(", ") }}]
      processors: [memory_limiter, resource_detection, resource/agent, batch]
      exporters: [otlp_http/sentinel]
{%- endif %}
{%- if otlp %}
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resource_detection, resource/agent, batch]
      exporters: [otlp_http/sentinel]
{%- endif %}
