# Copy to backend/.env for local development:  cp .env.example backend/.env
# Never commit a real .env file (it is git-ignored and scanned by gitleaks).

# dev | test | prod
SENTINEL_ENV=dev
# DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_LEVEL=INFO
# true = JSON lines, false = human-readable console output
SENTINEL_LOG_JSON=false

SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000

# Database (defaults match deploy/compose/compose.yaml; dev only).
# The API connects as sentinel_app; migrations run as sentinel_migrator.
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel_app:sentinel-app-dev-only@localhost:5432/sentinel
SENTINEL_MIGRATION_DATABASE_URL=postgresql+asyncpg://sentinel_migrator:sentinel-migrator-dev-only@localhost:5432/sentinel
SENTINEL_DB_POOL_SIZE=5
SENTINEL_DB_STATEMENT_TIMEOUT_MS=30000

# Read by deploy/compose/compose.yaml. The superuser is only used on first start to create roles.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-dev-only
POSTGRES_DB=sentinel
SENTINEL_DB_MIGRATOR_PASSWORD=sentinel-migrator-dev-only
SENTINEL_DB_APP_PASSWORD=sentinel-app-dev-only
SENTINEL_DB_READONLY_PASSWORD=sentinel-readonly-dev-only

# Auth. Generate a real key for anything non-local:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=dev-only-insecure-secret-key-change-me-0000
# false only for plain-http local dev; prod requires true
SENTINEL_COOKIE_SECURE=false
SENTINEL_SESSION_IDLE_TIMEOUT_MINUTES=720
SENTINEL_SESSION_ABSOLUTE_TIMEOUT_DAYS=7
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=5
SENTINEL_LOCKOUT_THRESHOLD=5
SENTINEL_LOCKOUT_MINUTES=15

# LLM gateway (Step 15). Ollama runs natively on the Mac; from a container use
# http://host.containers.internal:11434. The default model is decision D2.
SENTINEL_OLLAMA_URL=http://127.0.0.1:11434
SENTINEL_LLM_MODEL=qwen3:14b
SENTINEL_LLM_EMBED_MODEL=nomic-embed-text:v1.5
# Per-task overrides (JSON), e.g. {"report": "qwen3:8b"} and {"rca": false}
SENTINEL_LLM_TASK_MODELS={}
SENTINEL_LLM_TASK_THINKING={}
SENTINEL_LLM_NUM_CTX=16384
SENTINEL_LLM_KEEP_ALIVE=30m
# Stores prompts and replies in llm_call_payloads (kept 30 days). Off by default.
SENTINEL_LLM_STORE_PAYLOADS=false
